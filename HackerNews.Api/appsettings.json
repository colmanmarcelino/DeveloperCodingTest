{
  "HackerNews": {
    "BestStoriesUrl": "https://hacker-news.firebaseio.com/v0/beststories.json",
    "ItemUrlTemplate": "https://hacker-news.firebaseio.com/v0/item/{id}.json",
    "MaxStories": 500,
    "CacheSeconds": 60
  },
  "Jwt": {
    "Issuer": "HackerNews",
    "Audience": "HackerNewsClients",
    "SigningKey": "DEMO-ONLY-HackerNews-DEMO-ONLY-HackerNews-123456",
    "ExpirationMinutes": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    }
  },
  "Authorization": {
    "User": "demo",
    "Password": "demo"
  }
}
